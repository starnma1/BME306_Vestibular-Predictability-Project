library(tidyverse)
library(glue)
library(glmmTMB)
library(performance)
library(ggeffects)
library(readxl)
for (sample in 1:20) {
for (sample in 1:20) {
path <- "Data/"
sample           <- glue("B{sample}")
folder           <- Sys.glob(glue("{path}{sample}_*"))
processed_folder <- file.path(folder, "processed")
files            <- list.files(processed_folder,
pattern = "(only_forward|only_backward).*_trialResults\\.xlsx$",
full.names = TRUE)
for (f in files) {
obj_name <- sub("_trialResults\\.xlsx$", "", basename(f))
dat      <- read_xlsx(f)
print(str(dat))
}
}
for (sample in 1:20) {
path <- "Data/"
sample           <- glue("B{sample}")
folder           <- Sys.glob(glue("{path}{sample}_*"))
processed_folder <- file.path(folder, "processed")
files            <- list.files(processed_folder,
pattern = "(only_forward|only_backward).*_trialResults\\.xlsx$",
full.names = TRUE)
for (f in files) {
obj_name <- sub("_trialResults\\.xlsx$", "", basename(f))
dat      <- read_xlsx(f)
print(str(dat))
}
}
dat      <- dat[1:10,]
