prediction_plot <- function(raw_data, model, outcome_variable){
s <- seq(min(raw_data$p11), max(raw_data$p11), length.out = 100)
new_dat <- predict_response(model, terms = "p11 [s]")
plt <- ggplot(data = new_dat) +
geom_smooth(aes(x = x, y = predicted), method = "lm", formula = y ~ poly(x, 2)) +
#geom_ribbon(aes(x = x, y = predicted, ymin = conf.low, ymax = conf.high), alpha = .05) +
geom_point(data = raw_data, aes(x = p11, y = outcome_variable, group = p11),
alpha = 0.5, position = position_jitter(width = .2)) +
theme_bw()
return(plt)
}
prediction_plot(median_data, poly_fit_additive, median)
