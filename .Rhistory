grepl("only_forward", condition)  ~ 1,
grepl("only_backward", condition) ~ 1,
grepl("p11_0.75", condition)      ~ 0.75,
grepl("p11_0.5", condition)       ~ 0.5,
grepl("p11_0.25", condition)      ~ 0.25,
grepl("p11_0$", condition)        ~ 0
))
